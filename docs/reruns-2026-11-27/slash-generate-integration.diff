@@ -0,0 +1,48 @@
+// Сповіщення про новий лід у Telegram-чат менеджерів (Bot API, метод sendMessage).
+// Токен бота стоїть у шляху URL (`/bot<token>/`), тому помилки маскуються перед журналом і поверненням.
+import { readEnv } from "../core/config.js";
+import { postJson } from "../core/http.js";
+import { log, redact } from "../core/log.js";
+import { isRecord, parseJson } from "../core/parse.js";
+import type { Integration, Lead, Result } from "../core/types.js";
+
+const isTelegramOk = (value: unknown): value is { ok: true } => isRecord(value) && value.ok === true;
+
+export function formatTelegramMessage(lead: Lead): string {
+  const budget = lead.budgetUsd === undefined ? "бюджет не вказано" : `бюджет $${lead.budgetUsd}`;
+  return `Новий лід: ${lead.name} · ${lead.source} · ${budget}`;
+}
+
+function fail(leadId: string, error: string, token: string): Result<void> {
+  const safe = redact(error.replaceAll(token, "<REDACTED>"));
+  log.error(`telegram-notify: lead ${leadId} not delivered: ${safe}`);
+  return { ok: false, error: safe };
+}
+
+export const telegramNotify: Integration = {
+  name: "telegram-notify",
+  requiredEnv: ["TELEGRAM_API_URL", "TELEGRAM_BOT_TOKEN", "TELEGRAM_CHAT_ID"],
+
+  async send(lead: Lead): Promise<Result<void>> {
+    const apiUrl = readEnv("TELEGRAM_API_URL");
+    if (!apiUrl.ok) return apiUrl;
+    const token = readEnv("TELEGRAM_BOT_TOKEN");
+    if (!token.ok) return token;
+    const chatId = readEnv("TELEGRAM_CHAT_ID");
+    if (!chatId.ok) return chatId;
+
+    if (!apiUrl.value.startsWith("https://")) {
+      return { ok: false, error: "telegram-notify: TELEGRAM_API_URL must use https" };
+    }
+
+    const url = `${apiUrl.value.replace(/\/+$/, "")}/bot${token.value}/sendMessage`;
+    const response = await postJson(url, { chat_id: chatId.value, text: formatTelegramMessage(lead) });
+    if (!response.ok) return fail(lead.id, response.error, token.value);
+
+    const parsed = parseJson(response.value, isTelegramOk, "telegram-notify response");
+    if (!parsed.ok) return fail(lead.id, parsed.error, token.value);
+
+    log.info(`telegram-notify: lead ${lead.id} delivered`);
+    return { ok: true, value: undefined };
+  },
+};
